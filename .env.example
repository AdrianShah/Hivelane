# Copy to .env and fill in. Never commit real keys.

# --- Environment -------------------------------------------------------------
# development | staging | production. Outside development the relay refuses to
# start without CORS_ORIGINS, so a misconfigured deploy fails loudly.
HIVELANE_ENV=development

# Comma-separated browser origins allowed to call the relay. Required in
# staging/production; defaults to the local Vite dev server otherwise.
# CORS_ORIGINS=https://dashboard.example.com
# Opt-in wildcard for preview deploys, e.g. https://.*\.pages\.dev, leave empty
# unless you need it; a regex here widens who can call the relay.
# CORS_ORIGIN_REGEX=

# --- AI captions (optional) --------------------------------------------------
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_CAPTION_TIMEOUT=4.0
# GEMINI_CONFLICT_TIMEOUT=5.0

# --- Persistence -------------------------------------------------------------
# Path to a SQLite file on a persistent disk. Without it, room codes live only
# in memory and every deploy invalidates them, forcing everyone to rejoin.
# HIVELANE_STATE_PATH=/data/hivelane.db

# --- Abuse protection --------------------------------------------------------
# Turn on ONLY when the relay sits behind a proxy that sets X-Forwarded-For
# (Render, Cloudflare). Off, every user behind the proxy shares one bucket; on
# without a proxy, clients can spoof their IP and bypass the limits entirely.
# TRUST_PROXY_HEADER=false
# ROOM_CREATE_LIMIT=10
# ROOM_CREATE_WINDOW_SECONDS=3600
# WS_ATTEMPT_LIMIT=30
# WS_ATTEMPT_WINDOW_SECONDS=60
# RATE_LIMIT_MAX_TRACKED_IPS=4096
# Share the rate-limit counters across relay instances. Unset, each instance
# keeps its own per-IP budget. Needs the redis package (`pip install redis`;
# the Docker image includes it); while Redis is unreachable the relay logs a
# warning and falls back to per-process limits.
# HIVELANE_REDIS_URL=redis://localhost:6379/0
