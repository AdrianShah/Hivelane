# Copy to .env in this directory (deploy/compose/) and fill in. Never commit .env.

# Public hostname of the relay. DNS must point here before the first start so
# Caddy can obtain a certificate. The dashboard is then at https://<RELAY_DOMAIN>/
# and clients use wss://<RELAY_DOMAIN>/ws.
RELAY_DOMAIN=relay.example.com

# Exact origin(s) of dashboards hosted elsewhere, comma-separated. The bundled
# dashboard is same-origin and needs no entry, but the relay refuses to boot in
# production without one: if it is the only dashboard, use https://<RELAY_DOMAIN>.
CORS_ORIGINS=https://relay.example.com

# Optional: AI captions and conflict summaries.
GEMINI_API_KEY=

# Optional: Redis for room codes, room leases and rate-limit counters, shared
# by every relay instance. Only worth it once more than one instance runs, and
# then the instances also need room-affine routing (docs/self-hosting.md#scaling-out).
# A single relay keeps all of this itself.
# COMPOSE_PROFILES=redis
# HIVELANE_REDIS_URL=redis://redis:6379/0
# Redis for rate limits only, room codes stay on the relay's volume:
# HIVELANE_ROOM_STORE=local

# Optional: serve the API only, without the bundled dashboard.
# HIVELANE_STATIC_DIR=
