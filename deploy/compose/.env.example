# Copy to .env in this directory (deploy/compose/) and fill in. Never commit .env.

# Public hostname of the relay. DNS must point here before the first start so
# Caddy can obtain a certificate. Clients then use wss://<RELAY_DOMAIN>/ws.
RELAY_DOMAIN=relay.example.com

# Exact dashboard origin(s) allowed to call the relay, comma-separated.
# Required: the relay refuses to boot in production without it.
CORS_ORIGINS=https://synergo-dashboard.example.com

# Optional: AI captions and conflict summaries.
GEMINI_API_KEY=

# Optional: shared rate-limit counters in Redis. Only worth it once more than
# one relay instance runs; a single relay keeps its counters in-process. Rooms
# themselves still live in one relay's memory either way.
# COMPOSE_PROFILES=redis
# SYNERGO_REDIS_URL=redis://redis:6379/0
