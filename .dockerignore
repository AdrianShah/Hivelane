# The image needs server/, frontend/ and its entrypoint only: allow-list them so nothing else
# in the repo (the CLI, docs, local venvs, secrets) reaches the build context.
*
!server/
!frontend/
!deploy/docker-entrypoint.sh

# Within those, leave out tests, local builds and anything secret.
server/tests/
**/__pycache__/
**/*.pyc
frontend/node_modules/
frontend/dist/
frontend/Hivelane/
frontend/.vercel/
**/.env
**/.env.*
