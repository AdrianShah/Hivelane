#!/usr/bin/env bash
# Rebuild the graphify knowledge graph and include it in this commit.
# Enable once per clone:  git config core.hooksPath .githooks   (setup.sh does this)
set -euo pipefail

# Only rebuild when something outside graphify-out/ is staged.
if ! git diff --cached --name-only | grep -qv '^graphify-out/'; then
  exit 0
fi

GRAPHIFY="$(command -v graphify || true)"
[[ -z "$GRAPHIFY" && -x "$HOME/.local/bin/graphify" ]] && GRAPHIFY="$HOME/.local/bin/graphify"
if [[ -z "$GRAPHIFY" ]]; then
  echo "[graphify] not installed; skipping graph rebuild (uv tool install 'graphifyy[mcp]')" >&2
  exit 0
fi

"$GRAPHIFY" update . >/dev/null 2>&1 || { echo "[graphify] update failed; committing without graph refresh" >&2; exit 0; }
# Stage whatever graphify produced rather than a fixed file list: naming a file
# that a given graphify version does not write would fail under `set -e` and
# block every commit in the repo. .gitignore already excludes cache/ and
# dated snapshot directories.
if [[ -d graphify-out ]]; then
  git add -- graphify-out/
fi
